# Supabase — copy to .env.local and fill in from Project Settings → API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy NEXT_PUBLIC_SUPABASE_ANON_KEY is also supported when no publishable key is set.

# Public site URL used for canonical/OpenGraph metadata and sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000
